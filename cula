local AutoBtn = Instance.new("TextButton")
AutoBtn.Parent = MainFrame
AutoBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
AutoBtn.Position = UDim2.new(0.1, 0, 0.6, 0)
AutoBtn.Size = UDim2.new(0.8, 0, 0.28, 0)
AutoBtn.Font = Enum.Font.SourceSansBold
AutoBtn.Text = "Auto ALL SKP: OFF"
AutoBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
AutoBtn.TextSize = 14

local bodyVelocity, bodyGyro

local function startFlying()
    local character = LocalPlayer.Character
    if not character then return end
    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChild("Humanoid")
    if not root or not humanoid then return end

    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.P = 9e4
    bodyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
    bodyGyro.cframe = root.CFrame
    bodyGyro.Parent = root

    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.velocity = Vector3.new(0, 0, 0)
    bodyVelocity.maxForce = Vector3.new(9e9, 9e9, 9e9)
    bodyVelocity.Parent = root

    humanoid.PlatformStand = true

    task.spawn(function()
        while flying and character and root and root.Parent do
            task.wait()
            bodyGyro.cframe = Camera.CFrame
            bodyVelocity.velocity = Camera.CFrame.LookVector * flySpeed
        end
    end)
end

local function stopFlying()
    if bodyGyro then bodyGyro:Destroy() end
    if bodyVelocity then bodyVelocity:Destroy() end
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("Humanoid") then
        character.Humanoid.PlatformStand = false
    end
end

FlyBtn.MouseButton1Click:Connect(function()
    flying = not flying
    if flying then
        FlyBtn.Text = "Fly: ON"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        startFlying()
    else
        FlyBtn.Text = "Fly: OFF"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        stopFlying()
    end
end)

-- Fungsi Pemicu Klik untuk Semua Mini-Game SKP
local function doClick()
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
    task.wait(0.02)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
end

AutoBtn.MouseButton1Click:Connect(function()
    autoSKPEnabled = not autoSKPEnabled
    if autoSKPEnabled then
        AutoBtn.Text = "Auto ALL SKP: ON"
        AutoBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        
        task.spawn(function()
            while autoSKPEnabled do
                task.wait(0.05)
                pcall(function()
                    -- Cek semua UI latihan yang aktif (JJS, Pushup, Situp, Pullup)
                    local greenFound = false
                    for _, v in ipairs(PlayerGui:GetDescendants()) do
                        if v:IsA("GuiObject") and v.Visible then
                            -- Cari indikator warna hijau (area sukses mini-game)
                            local color = v.BackgroundColor3
                            if (color.G > 0.6 and color.R < 0.4 and color.B < 0.4) or color == Color3.fromRGB(0, 255, 0) then
                                greenFound = true
                                break
                            end
                        end
                    end
                    
                    -- Jika area mini-game/indikator hijau terdeteksi, lakukan auto-click
                    if greenFound then
                        doClick()
                    end
                end)
            end
        end)
    else
        AutoBtn.Text = "Auto ALL SKP: OFF"
        AutoBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)
